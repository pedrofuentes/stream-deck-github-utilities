{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Icon": "imgs/actions/repo-stats/icon",
      "Name": "Repo Stats",
      "States": [
        {
          "Image": "imgs/actions/repo-stats/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Display GitHub repository statistics (stars, issues, forks, watchers, PRs, language, size, license, branch, visibility)",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.repo-stats",
      "PropertyInspectorPath": "ui/repo-stats.html"
    },
    {
      "Icon": "imgs/actions/workflow-status/icon",
      "Name": "Workflow Status",
      "States": [
        {
          "Image": "imgs/actions/workflow-status/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Display the latest GitHub Actions workflow run status and deployment state",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.workflow-status",
      "PropertyInspectorPath": "ui/workflow-status.html"
    },
    {
      "Icon": "imgs/actions/pr-counter/icon",
      "Name": "PR Counter",
      "States": [
        {
          "Image": "imgs/actions/pr-counter/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Display the pull request count for a GitHub repository",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.pr-counter",
      "PropertyInspectorPath": "ui/pr-counter.html"
    },
    {
      "Icon": "imgs/actions/issue-counter/icon",
      "Name": "Issue Counter",
      "States": [
        {
          "Image": "imgs/actions/issue-counter/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Display the issue count for a GitHub repository",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.issue-counter",
      "PropertyInspectorPath": "ui/issue-counter.html"
    },
    {
      "Icon": "imgs/actions/release-monitor/icon",
      "Name": "Release Monitor",
      "States": [
        {
          "Image": "imgs/actions/release-monitor/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Display the latest release version for a GitHub repository",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.release-monitor",
      "PropertyInspectorPath": "ui/release-monitor.html"
    },
    {
      "Icon": "imgs/actions/commit-activity/icon",
      "Name": "Commit Activity",
      "States": [
        {
          "Image": "imgs/actions/commit-activity/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Display recent commit activity for a GitHub repository",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.commit-activity",
      "PropertyInspectorPath": "ui/commit-activity.html"
    },
    {
      "Icon": "imgs/actions/branch-comparison/icon",
      "Name": "Branch Comparison",
      "States": [
        {
          "Image": "imgs/actions/branch-comparison/key",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Show how many commits a branch is ahead or behind another branch",
      "UserTitleEnabled": false,
      "UUID": "com.pedrofuentes.github-utilities.branch-comparison",
      "PropertyInspectorPath": "ui/branch-comparison.html"
    }
  ],
  "Author": "Pedro Fuentes",
  "Category": "GitHub Utilities",
  "CategoryIcon": "imgs/plugin-icon",
  "CodePath": "bin/plugin.js",
  "Description": "A set of Stream Deck utilities to display information from GitHub repositories, pull requests, issues, and more.",
  "Icon": "imgs/plugin-icon",
  "Name": "GitHub Utilities",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "URL": "https://github.com/pedrofuentes/stream-deck-github-utilities",
  "UUID": "com.pedrofuentes.github-utilities",
  "Version": "1.5.0.0"
}